979_115" value="✎ 💵" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1B2430;fontSize=12;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1381" y="386" width="83" height="20" as="geometry"/></mxCell><mxCell id="c7979_116" value="Mostrando 5 de 12" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1B2430;fontSize=12;fontColor=#69747F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="526" width="520" height="16" as="geometry"/></mxCell><mxCell id="c7979_117" value="‹  1  ›" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1B2430;fontSize=12;fontColor=#69747F;fontSize=11;align=right;" vertex="1" parent="1"><mxGeometry x="1348" y="526" width="108" height="16" as="geometry"/></mxCell><mxCell id="c7979_118" value="Grid client-side (DataTables) sobre a lista completa carregada uma vez (EDP02 → C1); cada parcela é uma linha (RNF05). O modal Filtrar aplica em memória (RT01/RT02). Nova despesa e ícones de ação exigem PERM_DESPESAS_MANTER; a tela, PERM_DESPESAS_LISTAR. Coluna Rateio e ícone Ratear exigem PERM_DESPESA_RATEAR_MULTIUSUARIO (plano pago). O grid nunca traz despesa de outro usuário (RN02, RN19)." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1B2430;fontSize=12;fontColor=#69747F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="258" y="574" width="1210" height="40" as="geometry"/></mxCell><mxCell id="mk118_0" value="0" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D1367F;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="170" width="22" height="22" as="geometry"/></mxCell><mxCell id="mk118_1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D1367F;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="234" y="70" width="22" height="22"