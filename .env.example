# Credenciais LOCAIS de desenvolvimento.
# Copie este arquivo para .env (que fica fora do git) e preencha os valores.
#
# O .env alimenta:
#   - o docker-compose.yml (interpolação nativa do Compose)
#   - o application-dev.properties (carregado por DotenvEnvironmentPostProcessor na
#     subida da app — funciona no ./mvnw e no ▶ da IntelliJ, sem config extra)

#CREDENCIAIS BANCO DE DADOS
MYSQL_BANCO=dsc_dev_bd
MYSQL_USUARIO=root
MYSQL_SENHA=troque-por-uma-senha-local

#CREDENCIAIS SERVIÇO DE E-MAIL
# GMAIL_APP_SENHA: a senha de app de 16 caracteres, SEM os espaços que o Google mostra.
GMAIL_APP_EMAIL=seu-email@gmail.com
GMAIL_APP_SENHA=troque-por-uma-senha-de-app
