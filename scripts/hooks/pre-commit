#!/usr/bin/env bash
# Bloqueia o commit quando alguma assinatura de método/construtor Java fere a
# convenção de quebra de linha (guia-padroes-java.md, seção Formatação):
# até 5 parâmetros numa linha; 6+ um por linha.
set -euo pipefail

REPO_RAIZ="$(git rev-parse --show-toplevel)"
SCANNER="${REPO_RAIZ}/scripts/lint/verificar_assinaturas_java.py"

[[ -f "${SCANNER}" ]] || exit 0

if ! python3 "${SCANNER}" --staged; then
  echo ""
  echo "Commit abortado. Ajuste as assinaturas acima ou rode:"
  echo "    python3 scripts/lint/verificar_assinaturas_java.py --staged"
  exit 1
fi
